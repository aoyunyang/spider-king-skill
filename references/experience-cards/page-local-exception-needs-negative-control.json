  "id": "page-local-exception-needs-negative-control",
  "status": "promoted",
  "title": "Page-local request exceptions need a typed negative control",
  "invariant": "A page or cursor exception is reusable only after sibling pages keep the ordinary profile, the exceptional page fails a type-strict business oracle under that ordinary profile, and the same page passes only after one page-local request-profile change.",
  "scope": {
    "family": "session-gated",
    "boundary": "request",
    "appliesWhen": [
      "sibling pages already return the typed business payload on the ordinary request profile",
      "one page or cursor returns HTTP success with a hint, string, or otherwise untyped array",
      "a page-local request-profile exception is the hypothesized remaining gate"
    ],
    "stopsWhen": [
      "the ordinary profile already returns the typed business payload on that page",
      "the difference follows a session, signer, or transport-version mutation rather than the page-local profile",
      "sibling pages also require the exception profile"
    ]
  },
